# Supabase PostgreSQL Connection Credentials
# Provide these in your local environment or as system environment variables

SUPABASE_DB_URL=jdbc:postgresql://<YOUR_SUPABASE_HOST>:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<YOUR_PROJECT_REF>
SUPABASE_DB_PASSWORD=<YOUR_SUPABASE_DB_PASSWORD>
